<?xml version="1.0" encoding="utf-8"?>
<!--
  PesaCore.Api / PesaCore.Api — IIS hosting bundle configuration.

  This file is consumed by IIS (Windows Server) when the published app is
  deployed to an IIS site. It has zero effect when running locally with
  `dotnet run` (Kestrel-only on Mac/Linux).

  See docs/on_prem_deployment.md for the full annotation of every section.
  Each block here exists for a specific reason — banking-grade discipline.
-->
<configuration>

  <!--
    location/path="." inheritInChildApplications="false"
    Prevents this web.config from being inherited by virtual sub-applications
    if any are configured under the same site. Without this, downstream apps
    inherit our ANCM handler and fail to load their own runtime.
  -->
  <location path="." inheritInChildApplications="false">

    <system.webServer>

      <!--
        Register the ASP.NET Core Module V2 to handle every request.
        Without this handler, IIS doesn't know the site is .NET Core and
        attempts to serve it as static content (returning 404 or raw files).
      -->
      <handlers>
        <add name="aspNetCore"
             path="*"
             verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>

      <!--
        ASP.NET Core process configuration.

        processPath=dotnet, arguments=.\PesaCore.Api.dll:
          Framework-Dependent Deployment (FDD). Requires .NET 10 runtime
          installed on the Windows Server. Smaller artifact (~5 MB) than
          self-contained (~80 MB).

        stdoutLogEnabled=true:
          Captures Console.WriteLine + uncaught exception output to disk.
          CRITICAL for diagnosing startup failures — without this, a crashed
          startup gives 502.5 with no detail. Banking ops will thank you.

        stdoutLogFile=.\logs\stdout:
          Path is relative to the app root. IIS rotates these by appending
          PID + timestamp. Production: monitor for disk fill.

        hostingModel=inprocess:
          ANCM loads the dotnet runtime INSIDE w3wp.exe. Faster startup,
          lower latency. Default since .NET Core 2.2.

        Environment variables: pin ASPNETCORE_ENVIRONMENT to IIS so the app
        loads appsettings.IIS.json on top of appsettings.json.
        Production: set machine-level env vars for secrets; never put them
        here in source-controlled files.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\PesaCore.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="IIS" />
          <!--
            COMPlus_EnableDiagnostics=0:
              Disables runtime diagnostics endpoints in production.
              Reduces attack surface; not needed once observability is via OTel.
          -->
          <environmentVariable name="COMPlus_EnableDiagnostics" value="0" />
        </environmentVariables>
      </aspNetCore>

      <!--
        Request size cap — IIS-layer defense in depth.
        Default IIS limit is 28.6 MB. Banking APIs almost never need that.
        10 MB is generous for typical JSON / multi-part payloads.
        Match this to Kestrel.Limits.MaxRequestBodySize in Program.cs.
      -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="10485760" />
          <!--
            denyURLSequences: reject URLs containing these patterns.
            Defense against path-traversal probes and known scanner signatures.
          -->
          <denyUrlSequences>
            <add sequence=".." />
            <add sequence=".cgi" />
            <add sequence=".sh" />
          </denyUrlSequences>
        </requestFiltering>
      </security>

      <!--
        Standard security headers at the IIS layer.
        Defense in depth: ASP.NET Core middleware also sets HSTS in production,
        but adding here ensures even pre-pipeline responses get them.

        Remove X-Powered-By:
          IIS adds this by default ("X-Powered-By: ASP.NET"). Leaks framework
          version info — minor info disclosure. Removed.

        Strict-Transport-Security:
          Tell browsers HTTPS-only for 1 year. CBK / PCI-DSS / OWASP A02.

        X-Content-Type-Options: nosniff
          Prevent MIME-type sniffing. OWASP A05.

        X-Frame-Options: DENY
          Prevent clickjacking via iframe embedding. OWASP A05.
      -->
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="Strict-Transport-Security"
               value="max-age=31536000; includeSubDomains" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="DENY" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
          <!--
            Permissions-Policy: deny browser-feature access by default.
            Backend APIs don't legitimately need camera/mic/geolocation/payment/USB,
            so deny them at the IIS layer. Part of the OWASP Secure Headers baseline.
          -->
          <add name="Permissions-Policy"
               value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
        </customHeaders>
      </httpProtocol>

      <!--
        Response compression — gzip and brotli for text content types.
        Banking APIs return mostly JSON; compression reduces bandwidth ~70%
        on the wire. ASP.NET Core can also do this, but the IIS module is
        more efficient when the response is fully buffered.
      -->
      <httpCompression>
        <dynamicTypes>
          <add mimeType="application/json" enabled="true" />
          <add mimeType="application/problem+json" enabled="true" />
          <add mimeType="text/*" enabled="true" />
          <add mimeType="*/*" enabled="false" />
        </dynamicTypes>
      </httpCompression>

      <!--
        Default document — irrelevant for an API but harmless.
        IIS lists default docs even for API sites; explicitly clearing
        avoids any surprise behavior.
      -->
      <defaultDocument enabled="false" />

      <!--
        Enable httpErrors detailed = 'PassThrough' so ASP.NET Core's
        RFC 7807 problem-details responses pass through without IIS
        replacing them with its own ugly default error pages.
      -->
      <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

    </system.webServer>

  </location>

</configuration>

<!--
  Deployment notes (also see docs/on_prem_deployment.md):

  1. The IIS site's Application Pool MUST be set to "No Managed Code"
     (.NET CLR Version: No Managed Code). ASP.NET Core does NOT use the
     legacy CLR — ANCM loads the modern runtime separately.

  2. The Application Pool identity MUST have:
     - Read access to the deployed directory
     - SQL Server permissions (if using integrated auth)
     - Permissions to write to the `logs/` subdirectory (stdoutLogFile)

  3. The .NET 10 ASP.NET Core Hosting Bundle MUST be installed on the
     Windows Server before the first deploy. The bundle ships ANCM, the
     .NET runtime, and the dotnet CLI.
     Download: https://dotnet.microsoft.com/download/dotnet/10.0

  4. After deploy, verify by tailing the stdout log and curling /healthz
     from the server's localhost. A clean startup logs:
     [HH:mm:ss INF] Application started. Press Ctrl+C to shut down.

  5. To deploy without recycling the entire app pool, use msdeploy.exe
     with -enableRule:AppOffline (drops app_offline.htm during copy,
     gracefully shuts down dotnet, removes after copy).
-->
