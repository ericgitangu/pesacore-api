<?xml version="1.0" encoding="utf-8"?>
<!--
  PesaCore.Api / PesaCore.Api — IIS Publish Profile (FileSystem)

  This profile is consumed by:
    dotnet publish -p:PublishProfile=IISProfile -c Release

  Output: bin/Release/net10.0/publish/iis/

  The output directory contains everything IIS needs:
    - PesaCore.Api.dll (the entry point)
    - All managed dependencies (.dll)
    - Native dependencies for win-x64
    - web.config (already in src tree, copied to publish dir)
    - appsettings.json + appsettings.IIS.json + appsettings.Production.json
    - logs/ (created at runtime by stdoutLogFile)

  See docs/on_prem_deployment.md for the full annotation of every property.

  Workflow: Mac dev builds the artifact → uploads to deploy artifact repo
  → Windows Server pulls + extracts to inetpub/wwwroot/pesacore/.
  No Visual Studio required. CI-friendly.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!--
      FileSystem: publish to a directory.
      Production CI/CD switches to MSDeploy (WebDeploy) when the deploy
      pipeline can talk to a deployment endpoint over port 8172.
    -->
    <PublishProtocol>FileSystem</PublishProtocol>

    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>

    <TargetFramework>net10.0</TargetFramework>

    <!--
      win-x64: critical. Without explicit RuntimeIdentifier, native
      dependencies (SkiaSharp, libgit2, gRPC native) ship as cross-platform
      and may not work on Windows Server.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!--
      Framework-Dependent Deployment.
      Smaller artifact (~5 MB framework-only payload).
      Requires .NET 10 ASP.NET Core Hosting Bundle on the host server.

      Set SelfContained=true if Platform policy requires apps to ship their
      own runtime (immutable runtime guarantee per app, at the cost of
      ~80 MB per artifact and per-app patching).
    -->
    <SelfContained>false</SelfContained>

    <!--
      For IIS hosting, single-file is NOT useful — IIS expects a .dll
      entry point (specifically PesaCore.Api.dll referenced in web.config
      via the aspNetCore element's arguments attribute).
    -->
    <PublishSingleFile>false</PublishSingleFile>

    <!--
      Pre-compile MSIL → native code at publish time.
      Trade-off: ~30% larger artifact, ~50% faster startup.
      Banking choice: startup speed matters when an IIS app pool recycles
      under load; disk size doesn't matter on a Windows Server with TBs free.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!--
      ReadyToRun composite: bundles all assemblies into one R2R package.
      Slight startup speedup at expense of artifact size.
    -->
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>

    <!--
      Trimming: aggressively remove unused IL. NOT for ASP.NET Core apps —
      reflection-heavy frameworks (EF Core, MediatR, AutoMapper) break under
      trimming without extensive rooting. Off.
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!--
      Output directory. CI uploads this directory's contents as the deploy
      artifact (a .zip).
    -->
    <PublishDir>bin\Release\net10.0\publish\iis\</PublishDir>

    <!-- Don't delete files in PublishDir before publish — let CI control it. -->
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>true</ExcludeApp_Data>

    <!--
      Embed source code link in PDB for production debugging.
      Banking ops occasionally needs to attach a debugger to a production
      issue (rare, but the capability matters when a critical incident hits).
    -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!--
      EnvironmentName during publish — affects which appsettings files are
      copied. We don't filter — all of them are copied so the same artifact
      can be deployed to multiple environments via env-var override.
    -->
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>

  <!--
    Item-group customizations: include only files we want in the publish
    output. The default behavior is "include everything build produces"
    which is fine for now; explicit exclusions live here if needed.

    Example: exclude appsettings.Development.json from production publish:

    <ItemGroup>
      <None Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    </ItemGroup>
  -->
</Project>
