{
  // ===== PRODUCTION CONFIG — EQUITY BANKING API =====
  //
  // This file shows what a real banking API config looks like in production.
  // Values here are illustrative — real secrets come from Azure Key Vault
  // or environment variables, NEVER checked into source control.
  //
  // ASP.NET Core config precedence (highest wins):
  //   1. Environment variables (ASPNETCORE_*)
  //   2. appsettings.{Environment}.json  ← this file in Production
  //   3. appsettings.json                ← base/shared config
  //   4. User secrets (dev only)
  //
  // Java equivalent: application-prod.yml in Spring Boot
  // Python equivalent: .env.production or settings/production.py

  "ConnectionStrings": {
    // Production would be Azure SQL or Oracle (Finacle-adjacent).
    // Connection string comes from Azure Key Vault in real deployment:
    //   builder.Configuration.AddAzureKeyVault(...)
    // Never hardcode credentials — use Managed Identity or Key Vault references.
    //
    // Key settings:
    //   Encrypt=True            — TLS in transit (CBK mandate)
    //   TrustServerCertificate  — False in prod (validate the cert chain)
    //   Connection Timeout=30   — fail fast, don't hang threads
    //   Max Pool Size=100       — connection pool ceiling per app instance
    //   MultipleActiveResultSets=True — allows multiple open readers per connection
    "BankDb": "Server=tcp:equity-sql-prod.database.windows.net,1433;Database=EquityBankDb;Authentication=Active Directory Managed Identity;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Max Pool Size=100;MultipleActiveResultSets=True"
  },

  "Logging": {
    "LogLevel": {
      // Production: only warnings and above from framework internals.
      // Your app code (PesaCore.Api) stays at Information for audit trail.
      // EF Core SQL logging is OFF — sensitive data logging was dev-only.
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "PesaCore.Api": "Information"
    }
  },

  "Serilog": {
    // Production sinks: structured JSON to console (for container log aggregation)
    // + Seq/ELK/Application Insights for centralized querying.
    // Console in production uses JSON format, not human-readable —
    // the log aggregator parses JSON, not free text.
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        // Azure Application Insights for distributed tracing + alerting.
        // InstrumentationKey comes from Key Vault, not this file.
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": "FROM_KEY_VAULT"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },

  "AllowedHosts": "api.equitybank.co.ke;api.equitygroupholdings.com",

  // ===== CORS — locked to Equity's frontend domains =====
  // Dev uses "*"; production whitelists specific origins.
  "Cors": {
    "AllowedOrigins": [
      "https://app.equitybank.co.ke",
      "https://eazzybiz.equitybank.co.ke",
      "https://partner-bank.example"
    ]
  },

  // ===== RESILIENCE (Polly) — tuned for Finacle production latency =====
  // These values are externalized so ops can tune without a redeploy.
  "Resilience": {
    "Finacle": {
      "RetryCount": 3,
      "RetryBaseDelayMs": 200,
      "CircuitBreakerThreshold": 5,
      "CircuitBreakerDurationSeconds": 30,
      // Timeout per call — Finacle can be slow during EOD batch processing.
      // 10s is aggressive but prevents thread pool exhaustion at scale.
      "TimeoutSeconds": 10
    },
    "Daraja": {
      // M-Pesa Daraja API — different resilience profile.
      // Higher retry count because Daraja has transient failures but recovers fast.
      "RetryCount": 5,
      "RetryBaseDelayMs": 100,
      "CircuitBreakerThreshold": 10,
      "CircuitBreakerDurationSeconds": 15,
      "TimeoutSeconds": 30
    }
  },

  // ===== RATE LIMITING — protect downstream systems =====
  // Per-client rate limits prevent one partner from saturating Finacle.
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10,
    "QueueLimit": 25
  },

  // ===== SECURITY =====
  "Security": {
    // HSTS: Strict-Transport-Security header — 1 year, include subdomains.
    // CBK mandate: all banking traffic must be encrypted in transit.
    "HstsMaxAgeDays": 365,
    "HstsIncludeSubdomains": true,

    // JWT validation — Equity's identity provider (likely Azure AD or custom).
    "Jwt": {
      "Authority": "https://login.microsoftonline.com/equity-tenant-id/v2.0",
      "Audience": "api://equity-banking-api",
      "RequireHttpsMetadata": true
    },

    // API key header for partner bank API authentication.
    "ApiKeyHeaderName": "X-Api-Key"
  },

  // ===== CACHING (Redis) — query-side cache for CQRS =====
  "Redis": {
    // Azure Cache for Redis — Premium tier for persistence + geo-replication.
    "ConnectionString": "FROM_KEY_VAULT",
    "DefaultTtlSeconds": 60,
    "AccountBalanceTtlSeconds": 30,
    "TransactionHistoryTtlSeconds": 120
  },

  // ===== HEALTH CHECKS =====
  // Kubernetes liveness/readiness probes hit these endpoints.
  // If Finacle is unreachable, the readiness probe fails →
  // the load balancer stops routing traffic → no customer-facing errors.
  "HealthChecks": {
    "Finacle": {
      "Url": "https://finacle-gateway.equity.internal/health",
      "TimeoutSeconds": 5
    },
    "Database": {
      "TimeoutSeconds": 3
    }
  },

  // ===== FEATURE FLAGS =====
  // Phased rollouts — critical for banking where a bad feature
  // can affect millions of customers across 7 markets.
  "FeatureFlags": {
    "EnableIso20022Messaging": false,
    "EnableDualApprovalTransfers": true,
    "EnablePartnerBankApiV3": false,
    "EnableCrossMarketTransfers": true
  },

  // ===== OBSERVABILITY =====
  "OpenTelemetry": {
    "ServiceName": "equity-banking-api",
    "ExporterEndpoint": "https://otel-collector.equity.internal:4317",
    // Sampling: 10% of traces in production to control costs.
    // Critical paths (payments, transfers) are always sampled.
    "SamplingRatio": 0.1
  }
}
