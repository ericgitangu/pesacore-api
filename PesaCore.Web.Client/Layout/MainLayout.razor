@inherits LayoutComponentBase

<div class="shell">
    <aside class="rail">
        <a class="brand" href="">
            <span class="brand__glyph">₽</span>
            <span class="brand__name">PesaCore</span>
        </a>

        <nav class="nav">
            <NavLink class="nav__item" href="" Match="NavLinkMatch.All">
                <span class="nav__dot"></span> Accounts
            </NavLink>
            <NavLink class="nav__item" href="accounts/new">
                <span class="nav__dot"></span> New account
            </NavLink>
            <NavLink class="nav__item" href="transfer">
                <span class="nav__dot"></span> Transfer
            </NavLink>
        </nav>

        <div class="rail__foot">
            <div class="rail__env">
                <span class="rail__pulse"></span> Live · via BFF gateway
            </div>
            <p class="rail__note">Same-origin <code>/api/*</code> proxied to PesaCore. No CORS, no keys in the browser.</p>
        </div>
    </aside>

    <div class="frame">
        <header class="topbar">
            <div class="topbar__title">Core Banking Console</div>
            <div class="topbar__meta tnum">net10.0</div>
        </header>
        <main class="content">
            @Body
        </main>
    </div>
</div>
