{
  "uid": "dotnet-runtime",
  "title": ".NET Runtime — GC / ThreadPool / Exceptions",
  "tags": ["pesacore", "dotnet", "runtime"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "GC heap size by generation (bytes)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gc_heap_generation) (dotnet_gc_last_collection_heap_size_bytes)",
          "legendFormat": "{{gc_heap_generation}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "GC collections (rate by generation)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gc_heap_generation) (rate(dotnet_gc_collections_total[5m]))",
          "legendFormat": "{{gc_heap_generation}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "ThreadPool threads",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "expr": "dotnet_thread_pool_thread_count_total",
          "legendFormat": "thread count"
        }
      ]
    },
    {
      "id": 4,
      "title": "ThreadPool queue length",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "expr": "dotnet_thread_pool_queue_length_total",
          "legendFormat": "queue length"
        }
      ]
    },
    {
      "id": 5,
      "title": "Exceptions (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dotnet_exceptions_total[5m]))",
          "legendFormat": "exceptions/s"
        }
      ]
    }
  ]
}
