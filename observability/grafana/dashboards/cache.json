{
  "uid": "pesacore-cache",
  "title": "PesaCore — Cache (Cache-Aside Hit Ratio)",
  "tags": ["pesacore", "cache"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Cache hit ratio (hits / (hits + misses))",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pesacore_cache_hits_total[5m])) / clamp_min(sum(rate(pesacore_cache_hits_total[5m])) + sum(rate(pesacore_cache_misses_total[5m])), 1)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 2,
      "title": "Hit ratio by region",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (region) (rate(pesacore_cache_hits_total[5m])) / clamp_min(sum by (region) (rate(pesacore_cache_hits_total[5m])) + sum by (region) (rate(pesacore_cache_misses_total[5m])), 1)",
          "legendFormat": "{{region}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cache hits vs misses (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pesacore_cache_hits_total[5m]))",
          "legendFormat": "hits/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pesacore_cache_misses_total[5m]))",
          "legendFormat": "misses/s"
        }
      ]
    },
    {
      "id": 4,
      "title": "Idempotency cache hits (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pesacore_idempotency_hits_total[5m]))",
          "legendFormat": "idempotency hits/s"
        }
      ]
    }
  ]
}
